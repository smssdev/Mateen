{"n":95,"ayahs":[["وَٱلتِّينِ","وَٱلزَّيْتُونِ"],["وَطُورِ","سِينِينَ"],["وَهَٰذَا","ٱلْبَلَدِ","ٱلْأَمِينِ"],["لَقَدْ","خَلَقْنَا","ٱلْإِنسَٰنَ","فِىٓ","أَحْسَنِ","تَقْوِيمٍۢ"],["ثُمَّ","رَدَدْنَٰهُ","أَسْفَلَ","سَٰفِلِينَ"],["إِلَّا","ٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّٰلِحَٰتِ","فَلَهُمْ","أَجْرٌ","غَيْرُ","مَمْنُونٍۢ"],["فَمَا","يُكَذِّبُكَ","بَعْدُ","بِٱلدِّينِ"],["أَلَيْسَ","ٱللَّهُ","بِأَحْكَمِ","ٱلْحَٰكِمِينَ"]],"sim":{"3":[[90,3,0,0,4]],"5":[[26,226,0,0,5],[38,23,0,15,5],[84,24,0,0,5],[103,2,0,0,5]]}}